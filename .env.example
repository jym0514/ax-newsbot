# 로컬 개발용. 실제 값은 .env 에 넣고(.gitignore 처리됨),
# 운영에서는 GitHub Actions Secrets 로 주입한다.

# @BotFather 로 봇 생성 후 받은 토큰
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 다이제스트를 받을 채팅 ID (개인 채팅 또는 그룹/채널).
# 봇과 대화를 1회 시작한 뒤 아래로 확인:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_CHAT_ID=123456789

# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
